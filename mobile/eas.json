{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal" },
    "customer": { "env": { "APP_VARIANT": "customer", "EXPO_PUBLIC_APP_VARIANT": "customer" }, "autoIncrement": true },
    "drive": { "env": { "APP_VARIANT": "drive", "EXPO_PUBLIC_APP_VARIANT": "drive" }, "autoIncrement": true },
    "customer-preview": { "extends": "customer", "distribution": "internal", "android": { "buildType": "apk" } },
    "drive-preview": { "extends": "drive", "distribution": "internal", "android": { "buildType": "apk" } }
  },
  "submit": { "customer": {}, "drive": {} }
}
